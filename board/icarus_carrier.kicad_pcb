(kicad_pcb (version 20240108) (generator "icarus")
  (general (thickness 1.6))
  (paper "A3")
  (layers
    (0 "F.Cu" signal) (31 "B.Cu" signal) (32 "B.Adhes" user) (33 "F.Adhes" user)
  )
  (setup (pad_to_mask_clearance 0) (pcbplotparams (plot_on_all_layers_selection 0x00000000)))
  (footprint "Package_BGA:BGA-1024_25x25mm" (at 100 100) (descr "ICARUS 16c die 8x8mm")
    (pad "A1" smd rect (at 0 0) (size 0.4 0.4) (layers "F.Cu" "F.Paste" "F.Mask"))
  )
  (footprint "Connector:DDR10_DIMM_288pin" (at 50 150) (descr "DDR10 128b 25600MT/s"))
  (footprint "Connector:HDMI_A" (at 150 50) (descr "HDMI from rasterizer fb_x/y"))
  (net 0 "GND") (net 1 "VDD_0V85_7.76W") (net 2 "DDR10_DQ") (net 3 "CLK_3000M_0.333ns")
)
